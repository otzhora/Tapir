{
  "name": "@tapir/desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build:dependencies": "npm --workspace @tapir/core run build && npm --workspace @tapir/openapi run build && npm --workspace @tapir/storage run build",
    "predev": "npm run build:dependencies && node scripts/rebuild-native.mjs",
    "dev": "electron-vite dev",
    "prebuild": "npm run build:dependencies",
    "build": "vue-tsc --noEmit && electron-vite build",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "test": "node ../../node_modules/vitest/vitest.mjs run --configLoader runner",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.5",
    "@tapir/core": "0.0.1",
    "@tapir/openapi": "0.0.1",
    "@tapir/storage": "0.0.1",
    "codemirror": "^6.0.2",
    "electron-updater": "^6.6.2",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.4.34"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "electron": "^42.8.1",
    "electron-vite": "^5.0.0",
    "happy-dom": "^20.10.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vue-tsc": "^2.0.29"
  }
}
